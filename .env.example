# Environment Configuration for SaveMart Production

NODE_ENV=production
PORT=3000

# PostgreSQL Database Connection
DATABASE_URL=postgresql://savemart_user:YourStrongPasswordHere@localhost:5432/savemart_db

# Next.js Public URL
NEXT_PUBLIC_SITE_URL=https://savingmart.dk

# NextAuth.js Configuration
NEXTAUTH_URL=https://savingmart.dk
NEXTAUTH_SECRET=YourGeneratedRandomSecret32HexCharsHere

# Initial Admin User (for db:seed-admin)
ADMIN_EMAIL=admin@savemart.dk
ADMIN_INITIAL_PASSWORD=YourStrongInitialPassword123!

